{
  "name": "zect-desktop",
  "version": "3.0.0",
  "description": "ZECT Mentrix Control Tower — Desktop Application",
  "main": "main.js",
  "author": "ZECT Engineering",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:dev": "electron .",
    "start:prod": "cross-env ZECT_USE_DIST=1 electron .",
    "chatterbox:fetch": "powershell -NoProfile -File resources/chatterbox/scripts/fetch-chatterbox.ps1",
    "build:win": "python ../backend/packaging/bundle_sidecar.py && electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.zinnia.zect",
    "productName": "ZECT",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "computer.js",
      "chatterbox.js",
      "service-lifecycle.js",
      "wake.js",
      "win-wake.js",
      "dictation.js",
      "voice-filter.js",
      "shortcuts.js",
      "icons/**/*",
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/chatterbox",
        "to": "chatterbox",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icons/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    }
  }
}
