DATABASE_URL=sqlite:///./zect.db
GITHUB_TOKEN=
# Seed fake Dashboard projects (Policy Admin, Claims API, …). Default off; demos are purged on startup.
ZECT_SEED_DEMO_PROJECTS=false
# Presenton self-host base URL for Mentrix Generate deck (Docker default :5000)
PRESENTON_BASE_URL=http://127.0.0.1:5000
# Presentation engine: zect_native (ZECT generate, no Presenton Docker) | presenton (third-party :5000)
ZECT_PRESENTATION_PROVIDER=zect_native
# Optional Presenton master id for Zinnia presets (required for Zinnia live PASS)
# ZINNIA_PRESENTON_TEMPLATE_ID=your-presenton-master-id
PRESENTON_API_KEY=
PRESENTON_USERNAME=
PRESENTON_PASSWORD=
# Zoom desktop assist (Present Deck) — optional join URL; you still share screen yourself
# Mentrix opens Zoom / join link only — you join the meeting and share PowerPoint (no Meeting SDK).
ZOOM_DESKTOP_PATH=
ZOOM_DEFAULT_JOIN_URL=
# Windows / local clone root (defaults to /opt/zect-workspaces on Linux)
ZECT_WORKSPACE_ROOT=
OPENAI_API_KEY=
# Mentrix Local LLM gateway (OpenAI-compatible /v1). When set, Ask/Plan/Companion use this first.
# Start: services/mentrix-llm/scripts/up.ps1 — see docs/guides/MENTRIX_LLM_GATEWAY.md
# ZECT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ZECT_LLM_API_KEY=local
# ZECT_LLM_CHAT_MODEL=qwen2.5:7b
# MENTRIX_COMPANION_MODEL=qwen2.5:7b
# Mentrix Connect Voice — OpenAI Realtime (primary when key set; 0 forces STT fallback)
MENTRIX_REALTIME=1
MENTRIX_REALTIME_MODEL=gpt-realtime
MENTRIX_REALTIME_VOICE=alloy
MENTRIX_IMAGE_MODEL=dall-e-3

# Local auth (default)
# If unset in local/hybrid (non-production), defaults to admin@zect.local / zect-dev-local
ZECT_USERNAME=admin@zect.local
ZECT_PASSWORD=zect-dev-local
ZECT_AUTH_MODE=local
ZECT_AUTH_ENFORCE=true
# ENV=production  # disables auth defaults

# Azure AD / Entra OIDC (when ZECT_AUTH_MODE=oidc|hybrid)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_API_AUDIENCE=
AZURE_API_SCOPE=
AZURE_REDIRECT_URI=http://localhost:5173/login

# Mentrix / Lattice / RAG
LATTICE_ENABLED=true
LATTICE_INDEX_DOCS=1
MENTRIX_ENABLED=true
RAG_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=12
WAKE_PHRASE=Hey Mentrix
MENTRIX_MAX_STEPS=40
# Batched Build (human confirms between file batches)
MENTRIX_BUILD_BATCH_SIZE=6
MENTRIX_MAX_FILES_PER_RUN=40
MENTRIX_MAX_PARALLEL_UNITS=4
FINE_TUNE_ENABLED=false
MENTRIX_WORKSPACE=
MENTRIX_LINT_CMD=
# upgrade mode defaults lint strict to true when unset
MENTRIX_LINT_STRICT=false
MENTRIX_MAX_RECOVERY=3
MENTRIX_PR_DRY_RUN=true
# Semgrep via GitHub Check Runs (not in-process CLI). Off until org enables.
MENTRIX_SAST_REQUIRED=false
MENTRIX_SAST_CHECK_NAMES=Semgrep*,semgrep*,*semgrep*
MENTRIX_API_EVAL_BASE_URL=
MENTRIX_NOTIFY_EMAIL=

# MCP / integrations (Mentrix hub — org Jira/Datadog/GitHub/Slack)
# Prefer a ZECT service account for shared team use; configure also via /integrations.
MCP_JIRA_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
# Runner alias for JIRA_EMAIL (do not commit tokens):
# JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_INCIDENT_JQL=issuetype = Incident ORDER BY updated DESC
MCP_CONFLUENCE_URL=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
# Playwright MCP (optional): pip install playwright && playwright install chromium
MENTRIX_PLAYWRIGHT_HEADLESS=1
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#engineering
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mentrix email inbox digest (read-only IMAP). SMTP alone cannot read mail.
MENTRIX_IMAP_HOST=
MENTRIX_IMAP_PORT=993
MENTRIX_IMAP_USER=
MENTRIX_IMAP_PASSWORD=
MENTRIX_IMAP_FOLDER=INBOX

# Microsoft 365 / Graph (first-class Outlook mail+calendar when set; IMAP/SMTP remain fallback)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER=

# Mentrix Chatterbox — local synthesis via ZECT Voicebox (see docs/ZECT_VOICEBOX.md)
# Preferred. Legacy VOICEBOX_BASE_URL is still accepted as a fallback.
# Point at ZECT Voicebox (branded proxy on :17493), not raw upstream :17494.
CHATTERBOX_BASE_URL=http://127.0.0.1:17493
# CHATTERBOX_AUDIO_PATH_TEMPLATE=/audio/{filename}
# Default "qwen" — try a faster engine your local server supports if voice
# replies feel slow (synthesis is a blocking call; there's no streaming).
# CHATTERBOX_ENGINE=qwen
# Clone path requires the engine online (ZECT Voicebox + upstream). Stock OpenAI voices stay available when selected.
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=tts-1

# Mentrix PA-1 — shared orchestrator (set 0 to use legacy companion path)
MENTRIX_PA1_ORCHESTRATOR=1
# Browser hosts for Companion BrowserRuntime (comma-separated). Default is a
# curated allowlist — set * only if you intentionally want unrestricted hosts.
# MENTRIX_BROWSER_ALLOWLIST=github.com,localhost,127.0.0.1
# Optional integration allowlists (empty = no extra restriction)
# MENTRIX_EMAIL_ALLOWLIST=
# MENTRIX_SLACK_CHANNEL_ALLOWLIST=
# Calendar: ICS URL and/or demo events
# MENTRIX_CALENDAR_ICS_URL=
# MENTRIX_CALENDAR_DEMO=0
# Draft approval TTL (minutes)
# MENTRIX_DRAFT_TTL_MINUTES=30
# Skill manifest strict prohibited-ops enforcement
# MENTRIX_SKILL_MANIFEST_STRICT=1

# Phase 2 coding engine (server-side only — never send keys to the browser)
# Product default: mentrix_native. CI sets mock + ZECT_ALLOW_OFFLINE_BUILD_STUB=1.
ZECT_CODING_ENGINE=mentrix_native
ZECT_CODING_ENGINE_URL=
ZECT_CODING_ENGINE_API_KEY=
ZECT_CODING_ENGINE_TIMEOUT=30
ZECT_CODING_ENGINE_RETRIES=2
# Mentrix Coding Agent
# MENTRIX_CODING_AGENT_MAX_STEPS=24
# MENTRIX_CODING_AGENT_BUILD_TIMEOUT=240
# Allow offline Build stub (CI only) — product fails closed without LLM keys
# ZECT_ALLOW_OFFLINE_BUILD_STUB=0
# Isolation: worktree (default, no Docker) | docker | auto
# If docker is set but Docker is unavailable, falls back to worktree unless STRICT=1
ZECT_CODING_ENGINE_ISOLATION=auto
ZECT_CODING_ENGINE_ISOLATION_STRICT=0
ZECT_CODING_ENGINE_SANDBOX_IMAGE=python:3.12-slim
# Per-run git worktrees (must be under allowlisted roots / ZECT_WORKSPACE_ROOT)
ZECT_ENGINE_WORKSPACE_ROOT=
# Compatible remote Agent Server: pin a released image/version in deploy docs;
# do not install from an unpinned main branch in production.
# Optional compose: docker-compose.zect-coding-engine.yml
# ZECT_CODING_ENGINE_IMAGE=ghcr.io/all-hands-ai/openhands:0.32
# ZECT_CODING_ENGINE_HOST_PORT=3010

# ZECT Security Agent — malware scan daemon (services/zect-security-scan)
# ZECT_MALWARE_SCAN_HOST=127.0.0.1
# ZECT_MALWARE_SCAN_PORT=3310
# ZECT_MALWARE_SCAN_CLI=
# ZECT_MALWARE_SCAN_WRITES=1
# Schedule ticker (seconds); 0 disables in-process due runner
# ZECT_SCHEDULE_TICK_SECONDS=60

# Mentrix Process (BPM engine REST — product UI: Mentrix Process)
# ZECT_CAMUNDA_BASE_URL=http://127.0.0.1:8080/engine-rest
# ZECT_CAMUNDA_USER=
# ZECT_CAMUNDA_PASSWORD=
# ZECT_CAMUNDA_COCKPIT_URL=http://127.0.0.1:8080/camunda/app/cockpit/
